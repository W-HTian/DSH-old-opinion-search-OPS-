{
  "name": "dsh-recall",
  "version": "0.1.0",
  "private": true,
  "description": "Global full-text recall across every past DSH conversation: CJK-friendly substring search, project/time filters, snippets and context preview.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "search",
    "session-history",
    "cjk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/W-HTian/DSH-old-opinion-search-OPS-.git",
    "directory": "dsh-recall"
